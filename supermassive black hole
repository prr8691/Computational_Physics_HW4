plt.show()


# Plot log(r) as a function of time
plt.figure(figsize=(8, 5))

plt.plot(
    time_b,
    np.log10(r_b)
)

plt.xlabel("Time")
plt.ylabel(r"$\log_{10}(r)$")

plt.title(
    "Orbital Radius with Dynamical Friction"
)

plt.tight_layout()

plt.savefig(
    "hw4_problem2_logr.png",
    dpi=200
)

plt.show()


# =========================================================
# Convert code time to Myr
# =========================================================

G = 6.67430e-11
c = 299792458.0

pc = 3.085677581491367e16

year = 365.25*24*3600

# One distance unit is 100 pc
length_unit = 100.0*pc

# rs = 10^-7 in code units
rs_physical = 1e-7*length_unit

# Use rs = 2GM/c^2 to find the physical mass
mass_physical = (
    rs_physical*c**2
    / (2.0*G)
)

# Time unit from G = M = 1
time_unit = math.sqrt(
    length_unit**3
    / (G*mass_physical)
)

time_unit_myr = (
    time_unit
    / (1e6*year)
)


# =========================================================
# PART (c)
# Dependence on B/A
# =========================================================

values = np.array([
    0.5,
    1.0,
    2.0,
    5.0,
    10.0
])

ratios = []
times_myr = []
A_values = []

for A in values:

    for B in values:

        hit_time = time_to_radius(
            A,
            B,
            d,
            0.8
        )

        ratios.append(B/A)

        times_myr.append(
            hit_time*time_unit_myr
        )

        A_values.append(A)


ratios = np.array(ratios)

times_myr = np.array(times_myr)

A_values = np.array(A_values)


# Plot inspiral time against B/A
plt.figure(figsize=(8, 5))

for A in values:

    mask = A_values == A

    order = np.argsort(
        ratios[mask]
    )

    plt.plot(
        ratios[mask][order],
        times_myr[mask][order],
        marker="o",
        label=f"A = {A:g}"
    )

plt.xlabel("B/A")

plt.ylabel(
    "Time to reach $r_s$ (Myr)"
)

plt.title(
    "Inspiral Time vs B/A"
)

plt.legend()

plt.tight_layout()

plt.savefig(
    "hw4_problem2_ratio.png",
    dpi=200
)

plt.show()


# =========================================================
# PART (d)
# Test different initial velocities
# =========================================================

velocity_fractions = np.array([
    0.5,
    0.6,
    0.8,
    1.0,
    1.2
])

velocity_times = []

for fraction in velocity_fractions:

    hit_time = time_to_radius(
        1.0,
        1.0,
        d,
        fraction
    )

    velocity_times.append(
        hit_time*time_unit_myr
    )


# Also test the same B/A ratio with different A and B
same_ratio_values = np.array([
    0.5,
    1.0,
    2.0,
    5.0,
    10.0
])

same_ratio_times = []

for value in same_ratio_values:

    hit_time = time_to_radius(
        value,
        value,
        d,
        0.8
    )

    same_ratio_times.append(
        hit_time*time_unit_myr
    )


