import numpy as np
import matplotlib.pyplot as plt
import math

# ---------------------------------------------------------
# Problem 2: Supermassive black hole binary
# Adaptive RK4 with dynamical friction
# ---------------------------------------------------------

# Since G = M = 1, GM/4 = 1/4
mu = 0.25

# Error tolerance from part (a)
d = 1e-7

# Schwarzschild radius
rs = 1e-7


# ---------------------------------------------------------
# Equations of motion
# state = [x, y, vx, vy]
# ---------------------------------------------------------

def derivatives(state, A, B):

    x = state[0]
    y = state[1]
    vx = state[2]
    vy = state[3]

    r = math.sqrt(x*x + y*y)
    v = math.sqrt(vx*vx + vy*vy)

    # Gravity
    ax = -mu*x/r**3
    ay = -mu*y/r**3

    # Dynamical friction
    if A != 0:
        friction = -A/(v**3 + B)

        ax += friction*vx
        ay += friction*vy

    return np.array([vx, vy, ax, ay])


# ---------------------------------------------------------
# One fourth-order Runge-Kutta step
# ---------------------------------------------------------

def rk4_step(state, h, A, B):

    k1 = h*derivatives(state, A, B)

    k2 = h*derivatives(
        state + 0.5*k1,
        A,
        B
    )

    k3 = h*derivatives(
        state + 0.5*k2,
        A,
        B
    )

    k4 = h*derivatives(
        state + k3,
        A,
        B
    )

    return state + (k1 + 2*k2 + 2*k3 + k4)/6


# ---------------------------------------------------------
# Adaptive RK4
# Compares one full step to two half steps
# ---------------------------------------------------------

def integrate(state0, t_end, d, A, B, stop_radius):

    times = [0.0]
    states = [state0.copy()]

    state = state0.copy()

    t = 0.0
    h = 0.01

    while t < t_end:

        r = math.sqrt(
            state[0]**2 +
            state[1]**2
        )

        # Stop when the Schwarzschild radius is reached
        if stop_radius > 0 and r <= stop_radius:
            break

        if t + h > t_end:
            h = t_end - t

        # One full RK4 step
        big_step = rk4_step(
            state,
            h,
            A,
            B
        )

        # Two half RK4 steps
        half_step = rk4_step(
            state,
            h/2,
            A,
            B
        )

        small_step = rk4_step(
            half_step,
            h/2,
            A,
            B
        )

        # Estimate the error
        dx = small_step[0] - big_step[0]
        dy = small_step[1] - big_step[1]

        error = math.sqrt(
            dx*dx + dy*dy
        )/15

        target = d*h

        # Decide how much to change the timestep
        if error == 0:
            factor = 2.0

        else:
            factor = 0.9*(target/error)**0.2

            factor = min(
                2.0,
                max(0.2, factor)
            )

        # Accept the step
        if error <= target:

            state = (
                small_step
                + (small_step - big_step)/15
            )

            t += h

            times.append(t)
            states.append(state.copy())

            h *= factor

        # Reject the step and try again
        else:
            h *= factor

    return np.array(times), np.array(states)


# ---------------------------------------------------------
# This version only returns the time to reach rs
# Used for parts (c) and (d)
# ---------------------------------------------------------

def time_to_radius(A, B, d, velocity_fraction):

    # Circular velocity at r = 1 is 0.5
    state = np.array([
        1.0,
        0.0,
        0.0,
        0.5*velocity_fraction
    ])

    t = 0.0
    h = 0.01

    while t < 500:

        r = math.sqrt(
            state[0]**2 +
            state[1]**2
        )

        if r <= rs:
            return t

        big_step = rk4_step(
            state,
            h,
            A,
            B
        )

        half_step = rk4_step(
            state,
            h/2,
            A,
            B
        )

        small_step = rk4_step(
            half_step,
            h/2,
            A,
            B
        )

        dx = small_step[0] - big_step[0]
        dy = small_step[1] - big_step[1]

        error = math.sqrt(
            dx*dx + dy*dy
        )/15

        target = d*h

        if error == 0:
            factor = 2.0

        else:
            factor = 0.9*(target/error)**0.2

            factor = min(
                2.0,
                max(0.2, factor)
            )

        if error <= target:

            state = (
                small_step
                + (small_step - big_step)/15
            )

            t += h

            h *= factor

        else:
            h *= factor

    return np.nan


# =========================================================
# PART (a)
# Find a good error tolerance
# =========================================================

r_apo = 1.0
r_peri = 1e-7

# Semimajor axis
a_orbit = (r_apo + r_peri)/2

# Initial velocity from the vis-viva equation
v_initial = math.sqrt(
    mu*(
        2/r_apo
        - 1/a_orbit
    )
)

# Orbital period
period = 2*math.pi*math.sqrt(
    a_orbit**3/mu
)

state_a = np.array([
    1.0,
    0.0,
    0.0,
    v_initial
])

# No dynamical friction, so A = 0
time_a, states_a = integrate(
    state_a,
    10*period,
    d,
    0.0,
    1.0,
    -1.0
)

x_a = states_a[:, 0]
y_a = states_a[:, 1]

vx_a = states_a[:, 2]
vy_a = states_a[:, 3]

r_a = np.sqrt(
    x_a**2 +
    y_a**2
)

v2_a = (
    vx_a**2 +
    vy_a**2
)

# Orbital energy
energy = (
    0.5*v2_a
    - mu/r_a
)

# Angular momentum
angular_momentum = (
    x_a*vy_a
    - y_a*vx_a
)

energy_error = np.abs(
    (energy - energy[0])
    / energy[0]
)

L_error = np.abs(
    (angular_momentum - angular_momentum[0])
    / angular_momentum[0]
)


# Plot accuracy over 10 orbits
plt.figure(figsize=(8, 5))

plt.semilogy(
    time_a[1:],
    energy_error[1:],
    label="Relative energy error"
)

plt.semilogy(
    time_a[1:],
    L_error[1:],
    label="Relative angular momentum error"
)

plt.xlabel("Time")
plt.ylabel("Relative error")

plt.title(
    "Accuracy Check Over 10 Orbits"
)

plt.legend()

plt.tight_layout()

plt.savefig(
    "hw4_problem2_accuracy.png",
    dpi=200
)

plt.show()


