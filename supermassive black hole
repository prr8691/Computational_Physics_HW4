# =========================================================

velocity_fractions = [
    0.5,
    0.6,
    0.8,
    1.0,
    1.2
]

velocity_times = []

for fraction in velocity_fractions:

    hit_time = time_to_radius(
        1.0,
        1.0,
        d,
        fraction
    )

    velocity_times.append(
        hit_time*time_unit_myr
    )


# Test cases with the same B/A = 1
same_ratio_values = [
    0.5,
    1.0,
    2.0,
    5.0,
    10.0
]

same_ratio_times = []

for value in same_ratio_values:

    hit_time = time_to_radius(
        value,
        value,
        d,
        0.8
    )

    same_ratio_times.append(
        hit_time*time_unit_myr
    )


