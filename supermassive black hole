    100.0,
    d,
    1.0,
    1.0,
    rs
)

x_b = states_b[:, 0]
y_b = states_b[:, 1]

r_b = np.sqrt(
    x_b**2 +
    y_b**2
)


# Plot the path of the black hole
plt.figure(figsize=(6, 6))

plt.plot(
    x_b,
